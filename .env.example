# Copy to .env on the server and replace these placeholders.
# Never commit real credentials.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/HSB

# Admin access is disabled unless both a login number/username and password exist.
# ADMIN_NUMBER is accepted as the Basic Auth username; ADMIN_USERNAME is also supported.
ADMIN_NUMBER=
ADMIN_USERNAME=
ADMIN_PASSWORD=
