# LOCAL EXAMPLE ONLY: every value below is public and must be replaced before deployment.
# Copy to your protected runtime environment; never commit real credentials.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/HSB

# Example /admin login: use either identifier with the same password.
ADMIN_EMAIL=admin@example.test
ADMIN_PHONE=+620000000000
# Legacy identifier names remain supported.
ADMIN_NUMBER=
ADMIN_USERNAME=
ADMIN_PASSWORD=Example-Only-Admin-Password-2026!

# Keep this stable when existing encrypted customer data must remain readable.
SESSION_SECRET=EXAMPLE_ONLY_REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
