# Copy to .env on the server and replace every example value.
# Never commit a populated .env file or reuse these example values.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/HSB

# Both identifiers can be used to sign in to /admin with the same password.
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=+6281234567890
# Legacy identifier names remain supported.
ADMIN_NUMBER=
ADMIN_USERNAME=
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_16_CHARACTERS

# Keep this stable when existing encrypted customer data must remain readable.
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
