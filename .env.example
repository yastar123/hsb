# Copy to .env on the server and replace these placeholders.
# Never commit real credentials.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/HSB

# Admin access is disabled unless at least one login identifier and a password exist.
# Enter either ADMIN_EMAIL or ADMIN_PHONE on the /admin Basic Auth prompt.
ADMIN_EMAIL=
ADMIN_PHONE=
# Legacy identifier names remain supported.
ADMIN_NUMBER=
ADMIN_USERNAME=
ADMIN_PASSWORD=
